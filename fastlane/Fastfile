# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  
    # sh "your_script.sh"
    # You can also use other beta testing services here
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    upload_to_play_store
  end

  desc "Submit a new Internal Build to Play Store"
    lane :upload_to_internal do

      version_code = android_get_version_code()

      bumped_version_code = bump_version_code(version_code)
      bumped_version_name = convert_to_version_name(bumped_version_code)

      android_set_version_code(
        gradle_file: "app/build.gradle",
        version_code: bumped_version_code
      )

      android_set_version_name(
        gradle_file: "app/build.gradle",
        version_name: bumped_version_name
      )

      commit_and_tag(
        message: "Bump version to #{bumped_version_code}",
        tag: bumped_version_name
      )

      gradle(
        task: "bundle",
        flavor: "playstore",
        build_type: 'release',
        properties: {
          "android.injected.signing.store.file" => ENV["keystore_playstore_path"],
          "android.injected.signing.store.password" => ENV["keystore_playstore_password"],
          "android.injected.signing.key.alias" => ENV["keystore_playstore_key_alias"],
          "android.injected.signing.key.password" => ENV["keystore_playstore_key_password"],
        }
      )

      upload_to_play_store(
        track: 'internal',
        release_status: 'draft',
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true)
    end
end

desc "Commit and tag changes, then push to Git remote"
lane :commit_and_tag do |options|
  message = options[:message]
  tag = options[:tag]

  git_commit(
    path: "app/build.gradle",
    message: message
  )

  add_git_tag(
    tag: tag
  )

  push_to_git_remote

  UI.success("Committed changes with message '#{message}' and tagged with '#{tag}'.")
end

def bump_version_code(version_code)
    # Convert the version code to an integer
    version_code_int = version_code.to_i

    # Extract the last digit
    last_digit = version_code_int % 10

    # Remove the last digit
    version_code_without_last_digit = version_code_int / 10

    # Increment the remaining number
    incremented_version_code = version_code_without_last_digit + 1

    # Append the last digit back
    bumped_version_code = incremented_version_code * 10 + last_digit

    return bumped_version_code
end

def convert_to_version_name(version_code)
    # Convert versionCode to string
    version_str = version_code.to_s

    # Remove the last digit
    version_str = version_str[0..-2]

    # Add a leading zero if necessary
    version_str = version_str.rjust(8, '0')

    # Split the string into groups of digits
    groups = version_str.scan(/\d{2}/)

    # Convert each group to a single digit if possible
    groups.map! { |group| group.to_i.to_s }

    # Join the groups with a period
    version_name = groups.join(".")

    return version_name
end

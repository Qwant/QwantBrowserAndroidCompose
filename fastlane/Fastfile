# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:android)

platform :android do
  desc "Runs all the tests"
  lane :test do
    gradle(task: "test")
  end

  desc "Submit a new Beta Build to Crashlytics Beta"
  lane :beta do
    gradle(task: "clean assembleRelease")
    crashlytics
  
    # sh "your_script.sh"
    # You can also use other beta testing services here
  end

  desc "Deploy a new version to the Google Play"
  lane :deploy do
    gradle(task: "clean assembleRelease")
    upload_to_play_store
  end

  desc "Submit a new Internal Build to Play Store"
    lane :upload_to_internal do

      app_id = get_application_id()

      previous_build_number = google_play_track_version_codes(
        package_name: app_id,
        track: "internal"
      )[0].to_s

      current_build_number = bump_version_code(previous_build_number)

      android_set_version_code(
        gradle_file: "app/build.gradle",
        version_code: current_build_number
      )

      android_commit_version_bump(
        message: "Bump version to #{current_build_number}"
      )

      gradle(
        task: "bundle",
        flavor: "playstore",
        build_type: 'release',
        properties: {
          "android.injected.signing.store.file" => ENV["keystore_playstore_path"],
          "android.injected.signing.store.password" => ENV["keystore_playstore_password"],
          "android.injected.signing.key.alias" => ENV["keystore_playstore_key_alias"],
          "android.injected.signing.key.password" => ENV["keystore_playstore_key_password"],
        }
      )

      upload_to_play_store(
        track: 'internal',
        release_status: 'draft',
        skip_upload_metadata: true,
        skip_upload_images: true,
        skip_upload_screenshots: true)
    end
end

def bump_version_code(version_code)
    # Convert the version code to an integer
    version_code_int = version_code.to_s.to_i

    # Extract the last digit
    last_digit = version_code_int % 10

    # Remove the last digit
    version_code_without_last_digit = version_code_int / 10

    # Increment the remaining number
    incremented_version_code = version_code_without_last_digit + 1

    # Append the last digit back
    new_version_code = incremented_version_code * 10 + last_digit

    return new_version_code
end
